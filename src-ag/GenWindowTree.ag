-- Generating the list of boxes to paint (see Process.RenderBox).
-- Positions computed by WindowPosition.ag are relative to the parent box,
-- here they are turned into absolute positions of the canvas.

-- Distributing the baseurl, used to resolve relative links
ATTR All [ baseurl: String ||]

-- Distributing an url between children
ATTR All - WindowRoot [linkURL: {Maybe String} ||]
SEM WindowRoot
    | WindowRoot windowTree.linkURL = Nothing

SEM WindowTree
    | WindowItemContainer
        loc.linkURL = case Map.lookup "href" @attrs of
                        Just url -> Just url
                        Nothing  -> @lhs.linkURL
        elem.linkURL = @loc.linkURL
    | WindowContainer
        loc.linkURL = case Map.lookup "href" @attrs of
                        Just url -> Just url
                        Nothing  -> @lhs.linkURL
        elem.linkURL = @loc.linkURL
    | WindowText
        loc.linkURL = case Map.lookup "href" @attrs of
                        Just url -> Just url
                        Nothing  -> @lhs.linkURL

-- Distributing the absolute position of the parent box
ATTR All - WindowRoot [offset: {(Int,Int)} ||]
SEM WindowRoot
    | WindowRoot windowTree.offset = (0,0)

SEM WindowTree
    | WindowItemContainer
        loc.absPosition = addPoint @lhs.offset @loc.position
        elem.offset     = @loc.absPosition
    | WindowContainer
        loc.absPosition = addPoint @lhs.offset @loc.position
        elem.offset     = @loc.absPosition
    | WindowText
        loc.absPosition = addPoint @lhs.offset @loc.position

-- Building the list of boxes, in painting order (parents before children)
ATTR WindowRoot WindowTree [|| result: {[RenderBox]}]
SEM WindowTree
    | WindowItemContainer
        lhs.result = let markerPos = addPoint @lhs.offset @loc.markerPosition
                         marker    = case @marker of
                                        Numering str -> [RenderBox str markerPos @sizeMarker Full @props @attrs False Nothing]
                                        Glyph   name -> let attrs' = Map.insert "src" (name ++ ".png") @attrs
                                                        in [RenderBox "" markerPos @sizeMarker Full @props attrs' True Nothing]
                                        _            -> []
                         cbox      = RenderBox "" @loc.absPosition @loc.size Full @props @attrs False Nothing
                     in marker ++ (cbox : @elem.result)
    | WindowContainer
        lhs.result = RenderBox "" @loc.absPosition @loc.size @tCont @props @attrs @bRepl Nothing : @elem.result
    | WindowText
        lhs.result = [RenderBox @text @loc.absPosition @loc.size @tCont @props @attrs False (fmap (resolveURL @lhs.baseurl) @loc.linkURL)]

ATTR Element Lines Line [|| result USE {++} {[]} : {[RenderBox]}]
ATTR WindowTrees [|| result USE {++} {[]}: {[RenderBox]}]

{
addPoint :: (Int,Int) -> (Int,Int) -> (Int,Int)
addPoint (x1,y1) (x2,y2) = (x1 + x2, y1 + y2)

resolveURL :: String -> String -> String
resolveURL baseurl url
    = if isAbsolute url
      then url
      else if isHostRelative url
           then baseurl        ++ url
           else baseurl ++ "/" ++ url
}
